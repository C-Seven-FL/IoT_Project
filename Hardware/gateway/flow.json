    {
        "id": "2a207f789cab4808",
        "type": "function",
        "z": "49be379716f0b9e5",
        "name": "aggregate",
        "func": "const measurements = flow.get(\"measurements\") || {};\n\nconst result = [];\n\nfor (const deviceId in measurements) {\n\n    const records = measurements[deviceId];\n\n    if (records.length === 0) {\n        continue;\n    }\n\n    let tempSum = 0;\n    let x_last = 0;\n    let y_last = 0;\n    let z_last = 0;\n\n    for (const record of records) {\n        tempSum += record.temperature;\n        x_last = record.x;\n        y_last = record.y;\n        z_last = record.z;\n    }\n\n    result.push({\n        device_id: deviceId,\n        temperature: Number((tempSum / records.length).toFixed(2)),\n        status: true,\n        x: Number(x_last.toFixed(2)),\n        y: Number(y_last.toFixed(2)),\n        z: Number(z_last.toFixed(2)),\n    });\n}\n\nflow.set(\"measurements\", {});\n\nmsg.payload = result;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 340,
