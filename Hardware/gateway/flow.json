    {
        "id": "77cdf27372bfbd32",
        "type": "function",
        "z": "49be379716f0b9e5",
        "name": "sencorParser",
        "func": "function parseData(input) {\n    const regex = /<D>\\s+([a-f0-9]+):\\s+T:([\\d.]+)\\s+X:([-\\d.]+)\\s+Y:([-\\d.]+)\\s+Z:([-\\d.]+)/i;\n\n    const match = input.match(regex);\n\n    if (!match) {\n        return null;\n    }\n\n    return {\n        device_id: match[1],\n        temperature: parseFloat(match[2]),\n        x: parseFloat(match[3]),\n        y: parseFloat(match[4]),\n        z: parseFloat(match[5]),\n    };\n}\n\nreturn parseData(msg.payload);",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 600,
        "wires": [
