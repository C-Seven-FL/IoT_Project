    {
        "id": "77cdf27372bfbd32",
        "type": "function",
        "z": "49be379716f0b9e5",
        "name": "sencorParser",
        "func": "function parseData(input) {\n    const regex = /<D>\\s+([a-z0-9]+):\\s+T:([\\d.]+)\\s+X:([-\\d.]+)\\s+Y:([-\\d.]+)\\s+Z:([-\\d.]+)/i;\n\n    const match = input.match(regex);\n\n    if (!match) {\n        return null;\n    }\n\n    return {\n        device_id: match[1],\n        temperature: parseFloat(match[2]),\n        x: parseFloat(match[3]),\n        y: parseFloat(match[4]),\n        z: parseFloat(match[5]),\n    };\n}\n\nmsg.payload = parseData(msg.payload);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 180,
        "wires": [
            [
                "766e649abb983632"
            ]
        ]
    },
    {
        "id": "ed11b6231e321cde",
        "type": "function",
        "z": "49be379716f0b9e5",
        "name": "buttonParser",
        "func": "function parseButton(input) {\n\n    const regex = /<I>\\s+([a-f0-9]+):\\s+Button:(\\d)/i;\n\n    const match = input.match(regex);\n\n    if (!match) {\n        return null;\n    }\n\n    return {\n        device_id: match[1],\n        alarm: match[2] === \"0\"\n    };\n}\n\nconst result = parseButton(msg.payload);\n\nif (!result) {\n    return null;\n}\n\nif (result.alarm) {\n\n\n    flow.set(\"alarmMode\", true);\n\n    flow.set(\"lastAlarmDeviceButton\", result.device_id);\n\n    setTimeout(() => {\n        flow.set(\"alarmMode\", false);\n        flow.set(\"lastAlarmDeviceButton\", 0);\n    }, 60000);\n}\n\nmsg.payload = result;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 60,
        "wires": [
            [
                "3a39acd3dd756ede"
            ]
        ]
    },
