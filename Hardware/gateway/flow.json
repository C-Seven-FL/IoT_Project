        "func": "const data = msg.payload;\n\nif (!data) {\n    return null;\n}\n\nconst deviceId = data.device_id;\n\n\n\nfunction activateAlarm(type) {\n\n    flow.set(\"alarmMode\", true);\n\n    flow.set(type, true);\n\n    const existingTimer =\n        flow.get(type + \"_timer\");\n\n    if (existingTimer) {\n        clearTimeout(existingTimer);\n    }\n\n    const timer = setTimeout(() => {\n\n        flow.set(type, false);\n\n        flow.set(type + \"_timer\", null);\n\n        const earthquake =\n            flow.get(\"alarmEarthquake\");\n\n        const button =\n            flow.get(\"alarmButton\");\n\n        const temperature =\n            flow.get(\"alarmTemperature\");\n\n        if (\n            !earthquake &&\n            !button &&\n            !temperature\n        ) {\n            flow.set(\"alarmMode\", false);\n        }\n\n    }, 60000);\n\n    flow.set(type + \"_timer\", timer);\n}\n\n\n\nlet buttonSOS = false;\nlet temperatureAlarm = false;\nlet accelerometerAlarm = false;\n\n\n\nconst lastAlarmDevice =\n    flow.get(\"lastAlarmDeviceButton\");\n\nif (lastAlarmDevice === deviceId) {\n\n    buttonSOS = true;\n\n    activateAlarm(\"alarmButton\");\n}\n\n\n\nif (data.temperature >= 40) {\n\n    temperatureAlarm = true;\n\n    activateAlarm(\"alarmTemperature\");\n}\n\n\n\nlet previousMeasurements =\n    flow.get(\"previousMeasurements\") || {};\n\nconst previous =\n    previousMeasurements[deviceId];\n\nif (previous) {\n\n    const dx =\n        Math.abs(data.x - previous.x);\n\n    const dy =\n        Math.abs(data.y - previous.y);\n\n    const dz =\n        Math.abs(data.z - previous.z);\n\n    if (\n        dx >= 0.1 ||\n        dy >= 0.1 ||\n        dz >= 0.1\n    ) {\n\n        accelerometerAlarm = true;\n\n        activateAlarm(\"alarmEarthquake\");\n    }\n}\n\n\n\npreviousMeasurements[deviceId] = {\n    x: data.x,\n    y: data.y,\n    z: data.z\n};\n\nflow.set(\n    \"previousMeasurements\",\n    previousMeasurements\n);\n\n\n\nmsg.payload = {\n    device_id: data.device_id,\n    temperature: Number(data.temperature.toFixed(2)),\n    x: Number(data.x.toFixed(3)),\n    y: Number(data.y.toFixed(3)),\n    z: Number(data.z.toFixed(3)),\n    buttonSOS,\n    temperatureAlarm,\n    accelerometerAlarm,\n    timestamp: Date.now()\n};\n\n\n\nmsg.alarmMode =\n    buttonSOS ||\n    temperatureAlarm ||\n    accelerometerAlarm;\n\nreturn msg;",
