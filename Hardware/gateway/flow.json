                "7980f2ba9d3c075c"
            ]
        ]
    },
    {
        "id": "ed11b6231e321cde",
        "type": "function",
        "z": "49be379716f0b9e5",
        "name": "buttonParser",
        "func": "function parseButton(str) {\n    const regex = /<I>\\s+([a-f0-9]+):\\s+Button:(\\d)/i;\n\n    const match = str.match(regex);\n\n    if (!match) return null;\n\n    return {\n        device_id: match[1],\n        alarm: true \n    };\n}\n\nreturn parseButton(msg.payload);",
        "outputs": 1,
