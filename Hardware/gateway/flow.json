    {
        "id": "3c81d124816c6c39",
        "type": "function",
        "z": "49be379716f0b9e5",
        "name": "local buffer",
        "func": "const data = msg.payload;\n\nif (!data) {\n    return null;\n}\n\nlet measurements = flow.get(\"measurements\") || {};\n\nif (!measurements[data.device_id]) {\n    measurements[data.device_id] = [];\n}\n\nmeasurements[data.device_id].push(data);\n\nflow.set(\"measurements\", measurements);\n\nreturn msg;",
